{
  "name": "ai-theatre",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.player.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "admin": "tsx server/admin.ts",
    "test": "tsx --test src/scene/scene.test.ts server/billing/billing.test.ts server/accounts.test.ts server/lessons/jobs.test.ts server/features.test.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@huggingface/transformers": "3.8.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@theatre/core": "0.7.2",
    "@theatre/studio": "0.7.2",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "jsonrepair": "3.15.0",
    "kokoro-js": "1.2.1",
    "linkedom": "0.18.14",
    "lucide": "1.59.0",
    "lucide-react": "1.59.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
