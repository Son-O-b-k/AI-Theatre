# Copy to .env and fill in what you use. Everything is optional in development.

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset to use SQLite at data/app.db (no setup needed).
# Set to a Postgres URL to use Postgres instead; the schema is created on start.
# DATABASE_URL=postgres://user:password@localhost:5432/ai_theatre

# Where lessons, recorded narration, the voice model and the SQLite file live.
# DATA_DIR=data

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=8787
# Public address of the site, used for the return link after payment.
# PUBLIC_URL=https://aitheatre.example

# ── Email ───────────────────────────────────────────────────────────────────
# Sign-up confirmation, password reset and team invitations. Leave SMTP_HOST unset
# and emails are saved in data/outbox/ (links also printed in the server log).
# Templates: server/email/templates/.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="AI Theatre <hello@yourdomain.com>"

# ── Payments ────────────────────────────────────────────────────────────────
# Without billing.json the dev provider is used (no real payments).
# See billing.example.json; secrets there are written as env:NAME.
# BILLING_FILE=billing.json
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=

# ── AI providers ────────────────────────────────────────────────────────────
# See providers.example.json; keys there are written as env:NAME.
# PROVIDERS_FILE=providers.json
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
